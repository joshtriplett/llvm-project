; A scalable store of 32 * vscale bytes overlaps one 16 * vscale bytes
; above it.
define void @overlap_scalable_vscale(ptr %s, ptr %p, i64 %n) vscale_range(1,16) {
; CHECK-LABEL: 'overlap_scalable_vscale'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Report: unsafe dependent memory operations in loop. Use #pragma clang loop distribute(enable) to allow loop distribution to attempt to isolate the offending operations into a separate loop
; CHECK-NEXT:  Unknown data dependence.
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:        Unknown:
; CHECK-NEXT:            store <vscale x 4 x i64> %v, ptr %s, align 32 ->
; CHECK-NEXT:            store <vscale x 4 x i64> %v, ptr %b, align 32
; CHECK-EMPTY:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %b = getelementptr <vscale x 2 x i64>, ptr %s, i64 1
; CHECK-NEXT:        Against group GRP2:
; CHECK-NEXT:          %q = getelementptr inbounds i64, ptr %p, i64 %i
; CHECK-NEXT:      Check 1:
; CHECK-NEXT:        Comparing group GRP1:
; CHECK-NEXT:        ptr %s
; CHECK-NEXT:        Against group GRP2:
; CHECK-NEXT:          %q = getelementptr inbounds i64, ptr %p, i64 %i
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: ((16 * vscale)<nuw><nsw> + %s) High: ((48 * vscale)<nuw><nsw> + %s))
; CHECK-NEXT:            Member: ((16 * vscale)<nuw><nsw> + %s)
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: %s High: ((32 * vscale)<nuw><nsw> + %s))
; CHECK-NEXT:            Member: %s
; CHECK-NEXT:        Group GRP2:
; CHECK-NEXT:          (Low: %p High: ((8 * %n) + %p))
; CHECK-NEXT:            Member: {%p,+,8}<nuw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %b = getelementptr <vscale x 2 x i64>, ptr %s, i64 1
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %q = getelementptr inbounds i64, ptr %p, i64 %i
  %x = load i64, ptr %q
  %v = insertelement <vscale x 4 x i64> poison, i64 %x, i64 0
  store <vscale x 4 x i64> %v, ptr %s
  store <vscale x 4 x i64> %v, ptr %b
  %i.next = add nuw nsw i64 %i, 1
  %c = icmp eq i64 %i.next, %n
  br i1 %c, label %exit, label %loop

exit:
  ret void
}

; The distance is not constant, but 16 <= %off < 272.
define void @disjoint_range(ptr %s, ptr %p, i64 %n, i8 %k) {
; CHECK-LABEL: 'disjoint_range'
; CHECK-NEXT:    loop:
; CHECK-NEXT:      Memory dependences are safe with run-time checks
; CHECK-NEXT:      Dependences:
; CHECK-NEXT:      Run-time memory checks:
; CHECK-NEXT:      Check 0:
; CHECK-NEXT:        Comparing group GRP0:
; CHECK-NEXT:          %b = getelementptr i8, ptr %s, i64 %off
; CHECK-NEXT:        Against group GRP2:
; CHECK-NEXT:          %q = getelementptr inbounds i64, ptr %p, i64 %i
; CHECK-NEXT:      Check 1:
; CHECK-NEXT:        Comparing group GRP1:
; CHECK-NEXT:        ptr %s
; CHECK-NEXT:        Against group GRP2:
; CHECK-NEXT:          %q = getelementptr inbounds i64, ptr %p, i64 %i
; CHECK-NEXT:      Grouped accesses:
; CHECK-NEXT:        Group GRP0:
; CHECK-NEXT:          (Low: (16 + (zext i8 %k to i64) + %s) High: (24 + (zext i8 %k to i64) + %s))
; CHECK-NEXT:            Member: (16 + (zext i8 %k to i64) + %s)
; CHECK-NEXT:        Group GRP1:
; CHECK-NEXT:          (Low: %s High: (8 + %s))
; CHECK-NEXT:            Member: %s
; CHECK-NEXT:        Group GRP2:
; CHECK-NEXT:          (Low: %p High: ((8 * %n) + %p))
; CHECK-NEXT:            Member: {%p,+,8}<nuw><%loop>
; CHECK-EMPTY:
; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
; CHECK-NEXT:      SCEV assumptions:
; CHECK-EMPTY:
; CHECK-NEXT:      Expressions re-written:
;
entry:
  %kz = zext i8 %k to i64
  %off = add nuw nsw i64 %kz, 16
  %b = getelementptr i8, ptr %s, i64 %off
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %q = getelementptr inbounds i64, ptr %p, i64 %i
  %x = load i64, ptr %q
  store i64 %x, ptr %s
  store i64 %x, ptr %b
  %i.next = add nuw nsw i64 %i, 1
  %c = icmp eq i64 %i.next, %n
  br i1 %c, label %exit, label %loop

exit:
  ret void
}

